# Security
SECRET_KEY=change-this-to-a-long-random-secret
COOKIE_SECURE=false
TOKEN_EXPIRE_MINUTES=10080

# Storage. In Render, mount a persistent disk at /var/data
DATABASE_PATH=data/kn_nexus.db
UPLOADS_DIR=static/uploads

# Optional generic external data connectors. Keep blank to use clearly-labelled demo data.
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=
ECONOMIC_CALENDAR_API_URL=
ECONOMIC_CALENDAR_API_KEY=
NEWS_API_URL=
NEWS_API_KEY=
AI_PROVIDER_API_KEY=
